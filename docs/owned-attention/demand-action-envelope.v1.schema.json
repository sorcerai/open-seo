{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sorcerai.dev/schemas/owned-attention/demand-action-envelope.v1.schema.json",
  "title": "DemandActionEnvelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "projectId",
    "generatedAt",
    "producer",
    "lineage",
    "family",
    "evidence",
    "coverage",
    "decision",
    "economics",
    "governance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "owned-attention.demand-action.v1"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "supersedesEventId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "repository",
        "commit",
        "runId",
        "evidenceVersion",
        "selectionVersion"
      ],
      "properties": {
        "system": {
          "const": "open-seo"
        },
        "repository": {
          "const": "sorcerai/open-seo"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidenceVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "selectionVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "feedItemId",
        "familyId",
        "coverageCheckId",
        "scoreId",
        "decisionId"
      ],
      "properties": {
        "profileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "feedItemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "familyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "coverageCheckId": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "scoreId": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "decisionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalQuestion",
        "problemStatement",
        "intent",
        "funnelStage",
        "temporalRegime",
        "locale",
        "geography"
      ],
      "properties": {
        "canonicalQuestion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "problemStatement": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "intent": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "funnelStage": {
          "type": ["string", "null"],
          "enum": [
            "awareness",
            "consideration",
            "decision",
            "retention",
            "support",
            null
          ]
        },
        "temporalRegime": {
          "type": ["string", "null"],
          "enum": [
            "emerging",
            "persistent",
            "seasonal",
            "event_driven",
            "evergreen_latent",
            "decaying",
            "unknown",
            null
          ]
        },
        "locale": {
          "type": ["string", "null"],
          "maxLength": 64
        },
        "geography": {
          "type": ["string", "null"],
          "maxLength": 256
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independentEventCount",
        "sourceClassCounts",
        "observedLanguage",
        "provenanceRefs",
        "sourceHealth",
        "limitations"
      ],
      "properties": {
        "independentEventCount": {
          "type": "integer",
          "minimum": 0
        },
        "sourceClassCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "first_party",
            "official",
            "community",
            "search_observed",
            "generated",
            "other"
          ],
          "properties": {
            "first_party": {
              "type": "integer",
              "minimum": 0
            },
            "official": {
              "type": "integer",
              "minimum": 0
            },
            "community": {
              "type": "integer",
              "minimum": 0
            },
            "search_observed": {
              "type": "integer",
              "minimum": 0
            },
            "generated": {
              "type": "integer",
              "minimum": 0
            },
            "other": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "observedLanguage": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "generatedCandidates": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "provenanceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "sourceHealth": {
          "type": "string",
          "enum": ["healthy", "degraded", "incomplete", "failed", "unknown"]
        },
        "limitations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "candidateUrls", "reason", "recommendedAction"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "answered",
            "partial",
            "buried",
            "outdated",
            "contradicted",
            "missing",
            "unknown"
          ]
        },
        "candidateUrls": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          }
        },
        "reason": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "recommendedAction": {
          "type": "string",
          "enum": [
            "update_existing_page",
            "add_faq_or_direct_answer",
            "create_supporting_page",
            "create_comparison",
            "create_tool",
            "create_troubleshooter",
            "create_data_asset",
            "create_video",
            "create_sales_enablement",
            "update_offer_or_product",
            "create_support_article",
            "request_partnership_or_citation",
            "monitor_only",
            "reject"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "action", "reason", "reviewedBy", "reviewedAt"],
      "properties": {
        "kind": {
          "const": "accept"
        },
        "action": {
          "type": "string",
          "enum": [
            "update_existing_page",
            "add_faq_or_direct_answer",
            "create_supporting_page",
            "create_comparison",
            "create_tool",
            "create_troubleshooter",
            "create_data_asset",
            "create_video",
            "create_sales_enablement",
            "update_offer_or_product",
            "create_support_article",
            "request_partnership_or_citation",
            "monitor_only"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "businessValue",
        "monetizationCandidates",
        "estimatedProductionHours",
        "maintenanceRisk",
        "confidence"
      ],
      "properties": {
        "businessValue": {
          "type": ["string", "null"],
          "enum": ["low", "medium", "high", "unknown", null]
        },
        "monetizationCandidates": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "lead_generation",
              "affiliate",
              "paid_product",
              "sponsorship",
              "display",
              "none",
              "unknown"
            ]
          }
        },
        "estimatedProductionHours": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 10000
        },
        "maintenanceRisk": {
          "type": ["string", "null"],
          "enum": ["low", "medium", "high", "unknown", null]
        },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high", "unknown"]
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dryRun",
        "publicationAllowed",
        "autoPublishAllowed",
        "paidTrafficAllowed",
        "requiresHumanProductionApproval"
      ],
      "properties": {
        "dryRun": {
          "const": true
        },
        "publicationAllowed": {
          "const": false
        },
        "autoPublishAllowed": {
          "const": false
        },
        "paidTrafficAllowed": {
          "const": false
        },
        "requiresHumanProductionApproval": {
          "const": true
        }
      }
    }
  }
}
